@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
    <script>
        (function () {
            // Build quick section cards from same role rules as layout (reads sidebar's 'allowed' outcome if needed)
            let u = {}; try { u = JSON.parse(localStorage.getItem('userData') || '{}'); } catch {}
            const roles = Array.isArray(u.roles) ? u.roles : [];
            const roleMap = {
                ADMIN: ["User Management","Policy Management","Claim Review","Raise Ticket","Analytics","Claims","Client Support"],
                USER: ["View Policies","Submit Claim","Raise Ticket","Analytics"],
                AGENT: ["Policy Management","Client Support","Analytics"],
                CLAIM_ADJUSTER: ["Claim Review","Client Support","Analytics","Claims"]
            };
            const allowed = new Set(); roles.forEach(r => (roleMap[r]||[]).forEach(s => allowed.add(s)));
            const sectionRoute = {
                "User Management": "/Users","Policy Management": "/Policy","Claim Review": "/Claims/Review",
                "Raise Ticket": "/Tickets/Create","View Policies": "/Policy/My","Submit Claim": "/Claims/Create",
                "Client Support": "/Support","Analytics": "#analytics","Claims": "/Claims"
            };
            const sectionIcon = {
                "User Management":"bi-people","Policy Management":"bi-kanban","Claim Review":"bi-clipboard2-check",
                "Raise Ticket":"bi-life-preserver","View Policies":"bi-journal-text","Submit Claim":"bi-send",
                "Client Support":"bi-chat-dots","Analytics":"bi-graph-up","Claims":"bi-ui-checks-grid"
            };
            const container = document.getElementById('dashboardSections');
            allowed.forEach(section=>{
                const col = document.createElement('div');
                col.className = 'col-md-4';
                col.innerHTML = `
                  <div class="card h-100 shadow-sm">
                    <div class="card-body">
                      <h5 class="card-title mb-2"><i class="bi ${sectionIcon[section]||'bi-grid'} me-2"></i>${section}</h5>
                      <p class="card-text text-muted">Access ${section.toLowerCase()} features here.</p>
                      <a class="btn btn-primary" href="${sectionRoute[section]||'#'}">Go</a>
                    </div>
                  </div>`;
                container.appendChild(col);
            });

            // Charts
            const makeBar=(id,labels,label,data)=>new Chart(document.getElementById(id),{
                type:'bar', data:{labels, datasets:[{label,data}]},
                options:{responsive:true, maintainAspectRatio:false}
            });
            makeBar('chartPolicyType',["Health","Auto","Home","Life","Travel"],"Policies",[120,90,65,150,40]);
            makeBar('chartClaimAmount',["Q1","Q2","Q3","Q4"],"Amount (k$)",[210,150,260,190]);
        })();
    </script>
}

