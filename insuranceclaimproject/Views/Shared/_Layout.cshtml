@* Collapsible sidebar + top navbar layout (Bootstrap 5) *@

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool showSidebar = !(currentController == "AuthenticationUI" &&
                         (currentAction == "LoginRegister") || (currentController == "Landing"));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Insurance</title>
    <link rel="stylesheet" href="~/css/stylesnew.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --sbw: 240px; /* expanded width */
            --sbw-collapsed: 72px; /* collapsed width (icons only) */
        }

        body {
            background: #f8f9fa;
        }

        /* Layout grid - ONLY apply when has-sidebar class is present */
        .app.has-sidebar {
            display: grid;
            grid-template-columns: var(--sbw) 1fr;
            grid-template-rows: 56px auto;
            grid-template-areas:
                "sidebar topbar"
                "sidebar content";
            min-height: 100vh;
        }

        .app.has-sidebar.sb-collapsed {
            grid-template-columns: var(--sbw-collapsed) 1fr;
        }

        /* For pages without sidebar - normal flow layout */
        .app:not(.has-sidebar) {
            min-height: 100vh;
        }

        .app:not(.has-sidebar) .content {
            padding: 0; /* Remove padding for full-width pages like login */
        }

        /* Sidebar */
        .sidebar {
            grid-area: sidebar;
            background: #ffffff;
            border-right: 1px solid #e9ecef;
            position: sticky;
            top: 0;
            height: 100vh;
            padding: .75rem .5rem;
            z-index: 1020;
        }

        .sb-brand {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-weight: 600;
            margin: .25rem .25rem 1rem .25rem;
        }

        .sb-toggle {
            border: 0;
            background: transparent;
            font-size: 1.25rem
        }

        .sb-nav .nav-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .5rem .75rem;
            border-radius: .75rem;
            color: #495057;
        }

        .sb-nav .nav-link.active, .sb-nav .nav-link:hover {
            background: #f1f3f5;
            color: #111;
        }

        .app.has-sidebar.sb-collapsed .sb-text {
            display: none;
        }

        .app.has-sidebar.sb-collapsed .sb-brand-text {
            display: none;
        }

        .app.has-sidebar.sb-collapsed .nav-link {
            justify-content: center;
        }

        /* Topbar */
        .topbar {
            grid-area: topbar;
            background: #ffffff;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .5rem .75rem;
            position: sticky;
            top: 0;
            z-index: 1025;
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: .25rem .5rem;
            border-radius: 999px;
            background: #f8f9fa;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0d6efd;
            color: #fff;
            font-size: .9rem;
            font-weight: 600;
        }

        .user-meta {
            line-height: 1.1;
        }

        .user-meta .name {
            font-weight: 600;
        }

        .user-meta .sub {
            font-size: .75rem;
            color: #6c757d;
        }

        /* Content */
        .content {
            grid-area: content;
            padding: 1rem;
        }
    </style>

    @RenderSection("Head", required: false)
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Add conditional 'has-sidebar' class -->
    <div id="app" class="app @(showSidebar ? "has-sidebar" : "")">
        @if (showSidebar)
        {
            <!-- SIDEBAR -->
            <aside class="sidebar">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="sb-brand">
                      <a class="navbar-brand text-primary" href="#">
                <i class="fas fa-heartbeat me-2"></i>MediClaim
            </a>
                    </div>
                    <button id="sbToggle" class="sb-toggle" title="Toggle sidebar">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </button>
                </div>

                <nav class="sb-nav nav flex-column">
                    <!-- Use data-section for role gating -->
                    <a class="nav-link" href="/Dashboard">
                        <i class="bi bi-speedometer2"></i> <span class="sb-text">Dashboard</span>
                    </a>
                    <a class="nav-link" data-section="Policy Management" href="/Policy">
                        <i class="bi bi-kanban"></i> <span class="sb-text">Policy Management</span>
                    </a>
                    <a class="nav-link" data-section="Claims" href="/Claims">
                        <i class="bi bi-ui-checks-grid"></i> <span class="sb-text">Claims</span>
                    </a>
                    <a class="nav-link" data-section="Claim Review" href="/Claims/Review">
                        <i class="bi bi-clipboard2-check"></i> <span class="sb-text">Claim Review</span>
                    </a>
                    <a class="nav-link" data-section="Raise Ticket" href="/support">
                        <i class="bi bi-life-preserver"></i> <span class="sb-text">Raise Ticket</span>
                    </a>
                    <a class="nav-link" data-section="User Management" href="/Users">
                        <i class="bi bi-people"></i> <span class="sb-text">User Management</span>
                    </a>
                </nav>
            </aside>

            <!-- TOP NAVBAR -->
            <header class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <button id="sbToggle2" class="btn btn-light btn-sm d-lg-none">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="fw-semibold">Dashboard</span>
                </div>
                <div class="user-pill">
                    <div class="avatar" id="avatar">U</div>
                    <div class="user-meta">
                        <div class="name" id="topUserName">User</div>
                        <div class="sub"><span id="topRoles">ROLE</span> · <span id="topEmail">user@example.com</span></div>
                    </div>
                    <button id="logoutBtn" class="btn btn-outline-danger btn-sm ms-2" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </header>
        }
        <!-- MAIN CONTENT -->
        <main class="content">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        @if (showSidebar)
        {
            <text>
            (function () {
                // Sidebar toggle + remember state
                const app = document.getElementById('app');
                const KEY = 'sidebar-collapsed';
                const setCollapsed = (v)=>{ v ? app.classList.add('sb-collapsed') : app.classList.remove('sb-collapsed'); localStorage.setItem(KEY, v ? '1':'0'); };
                setCollapsed(localStorage.getItem(KEY) === '1');
                document.getElementById('sbToggle') .addEventListener('click', ()=> setCollapsed(!app.classList.contains('sb-collapsed')));
                document.getElementById('sbToggle2').addEventListener('click', ()=> setCollapsed(!app.classList.contains('sb-collapsed')));

                // Load user from localStorage and fill topbar
                let u = {};
                try { u = JSON.parse(localStorage.getItem('userData') || '{}'); } catch {}
                const roles = Array.isArray(u.roles) ? u.roles : [];
                const name  = (u.username || 'User').toString();
                const email = (u.email || '').toString();
                document.getElementById('topUserName').textContent = name;
                document.getElementById('topRoles').textContent    = roles.join(', ') || 'USER';
                document.getElementById('topEmail').textContent    = email || '—';
                document.getElementById('avatar').textContent      = (name.trim()[0] || 'U').toUpperCase();

                // Logout handler
                const LOGOUT_URL = '/AuthenticationUI/LoginRegister';
                const logoutBtn = document.getElementById('logoutBtn');
                if (logoutBtn) {
                    logoutBtn.addEventListener('click', function(){
                        try { localStorage.removeItem('userData'); } catch {}
                        window.location.href = LOGOUT_URL;
                    });
                }

                // Role gating for sidebar links
                const roleMap = {
                    ADMIN: ["User Management","Policy Management","Claim Review","Raise Ticket","Analytics","Claims","Client Support"],
                    USER: ["View Policies","Submit Claim","Raise Ticket","Analytics"],
                    AGENT: ["Policy Management","Client Support","Analytics"],
                    CLAIM_ADJUSTER: ["Claim Review","Client Support","Analytics","Claims"]
                };
                const allowed = new Set(); roles.forEach(r => (roleMap[r]||[]).forEach(s => allowed.add(s)));
                document.querySelectorAll('[data-section]').forEach(el=>{
                    const s = el.getAttribute('data-section');
                    // if no roles provided, do not hide; otherwise require membership
                    el.style.display = (allowed.size===0 || allowed.has(s)) ? '' : 'none';
                });
            })();
            </text>
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>