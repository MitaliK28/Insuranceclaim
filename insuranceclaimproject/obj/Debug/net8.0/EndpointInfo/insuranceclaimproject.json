  "components": {
    "schemas": {
      "ClaimStatus": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "CreateDocumentDto": {
        "required": [
          "claimId",
          "documentName",
          "documentPath"
        ],
        "type": "object",
        "properties": {
          "claimId": {
            "type": "integer",
            "format": "int32"
          },
          "documentName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "documentPath": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "documentType": {
            "$ref": "#/components/schemas/DocumentType"
          }
        },
        "additionalProperties": false
      },
      "CreatePolicyDto": {
        "required": [
          "coverageAmount",
          "policyholderId",
          "policyNumber"
        ],
        "type": "object",
        "properties": {
          "policyNumber": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "policyholderId": {
            "minLength": 1,
            "type": "string"
          },
          "coverageAmount": {
            "minimum": 1,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateSupportTicketDto": {
        "required": [
          "issueDescription",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "minLength": 1,
            "type": "string"
          },
          "issueDescription": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DocumentType": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      },
      "PolicyStatus": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "RegisterUserDto": {
        "required": [
          "email",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "SubmitClaimDto": {
        "required": [
          "claimAmount",
          "policyId"
        ],
        "type": "object",
        "properties": {
          "policyId": {
            "type": "integer",
            "format": "int32"
          },
          "claimAmount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "TicketStatus": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "UpdateClaimStatusDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          }
        },
        "additionalProperties": false
      },
      "UpdatePolicyDto": {
        "required": [
          "coverageAmount"
        ],
        "type": "object",
        "properties": {
          "coverageAmount": {
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "policyStatus": {
            "$ref": "#/components/schemas/PolicyStatus"
          }
        },
        "additionalProperties": false
      },
      "UpdateSupportTicketStatusDto": {
        "required": [
          "ticketStatus"
        ],
        "type": "object",
        "properties": {
          "ticketStatus": {
            "$ref": "#/components/schemas/TicketStatus"
          }
        },
        "additionalProperties": false
      },
      "UserLoginDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\"",
        "scheme": "Bearer"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
